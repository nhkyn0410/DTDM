# Chép thành .env rồi sửa. File .env không được commit (đã có trong .gitignore).

# Mặc định: SQLite + cụm giả lập trong bộ nhớ, chạy được ngay trên Windows.
MINICLOUD_DATABASE_URL=sqlite:///./minicloud.db
MINICLOUD_DRIVER=fake

# Khi nối cụm Incus thật (xem infra/README.md):
# MINICLOUD_DRIVER=incus
# MINICLOUD_INCUS_URL=https://192.168.1.11:8443
# MINICLOUD_INCUS_CLIENT_CERT=secrets/client.crt
# MINICLOUD_INCUS_CLIENT_KEY=secrets/client.key
# MINICLOUD_INCUS_CA_CERT=secrets/cluster.crt
# Băng thông tối đa mỗi chiều cho mỗi instance (threat model dòng 10); để trống để bỏ giới hạn.
# MINICLOUD_INCUS_NIC_LIMIT=20Mbit
# Máy của khách không gửi gói tin thẳng cho nhau trên bridge dùng chung (false để tắt).
# MINICLOUD_INCUS_PORT_ISOLATION=true

# Giới hạn tần suất theo IP: số lần đăng ký mỗi giờ, số lần sai API key trong 10 phút (0 = tắt).
# MINICLOUD_RATE_LIMIT_SIGNUPS_PER_HOUR=5
# MINICLOUD_RATE_LIMIT_AUTH_FAILURES=50

# PostgreSQL (docker compose -f deploy/docker-compose.dev.yml up -d, rồi uv sync --extra postgres):
# MINICLOUD_DATABASE_URL=postgresql+psycopg://minicloud:minicloud@localhost:5432/minicloud

# URL công khai cho app của khách (ADR-0005). Để trống MINICLOUD_PUBLIC_DOMAIN để tắt.
# Mỗi container có https://<tên>-<6 ký tự>.vexenhanh.id.vn, trỏ tới cổng 80 trong container.
# MINICLOUD_PUBLIC_DOMAIN=vexenhanh.id.vn
# MINICLOUD_INGRESS_ROUTES_FILE=/etc/traefik/dynamic/minicloud.yml

# Xếp instance: spread (dàn đều) hoặc binpack (dồn cho Green cloud)
MINICLOUD_PLACEMENT_POLICY=spread

# Bắt buộc đặt khi API ra Internet: người đăng ký phải gửi kèm mã này.
# MINICLOUD_SIGNUP_INVITE_CODE=doi-ma-nay

# Quy đổi tham khảo hiện cạnh giá và trên sao kê (docs/bang-gia.md); credit không phải tiền thật.
# MINICLOUD_VND_PER_CREDIT=10
# Worker im lặng lâu hơn chừng này giây (laptop tắt, ngủ) thì máy đang chạy không bị tính tiền
# cho khoảng đó; audit log ghi metering.gap.
# MINICLOUD_METERING_MAX_GAP_SECONDS=300

# Green cloud: laptop chạy control plane không bao giờ ngủ; điền công suất đo được của laptop.
MINICLOUD_GREEN_PINNED_NODES=laptop-1
MINICLOUD_GREEN_IDLE_WATTS=8
MINICLOUD_GREEN_MAX_WATTS=35
# Công suất riêng từng laptop (W lúc nhàn/W lúc chạy hết CPU), thay cho hai dòng trên:
# MINICLOUD_GREEN_NODE_WATTS=laptop-1=44.5/45.8,laptop-2=19.1/38.3,laptop-3=38.2/40.7
# Hệ số phát thải của lưới điện, kg CO2 mỗi kWh:
# MINICLOUD_GREEN_GRID_KG_CO2_PER_KWH=0.681
# MAC cổng mạng dây của từng laptop, để đánh thức bằng Wake-on-LAN (POST /v1/admin/nodes/{tên}/wake):
# MINICLOUD_GREEN_NODE_MACS=laptop-2=B0:82:E2:69:38:55,laptop-3=E4:A8:DF:D4:1E:64

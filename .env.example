# Chép thành .env rồi sửa. File .env không được commit (đã có trong .gitignore).

# Mặc định: SQLite + cụm giả lập trong bộ nhớ, chạy được ngay trên Windows.
MINICLOUD_DATABASE_URL=sqlite:///./minicloud.db
MINICLOUD_DRIVER=fake

# Khi nối cụm Incus thật (xem infra/README.md):
# MINICLOUD_DRIVER=incus
# MINICLOUD_INCUS_URL=https://192.168.1.11:8443
# MINICLOUD_INCUS_CLIENT_CERT=secrets/client.crt
# MINICLOUD_INCUS_CLIENT_KEY=secrets/client.key
# MINICLOUD_INCUS_CA_CERT=secrets/cluster.crt

# PostgreSQL (docker compose -f deploy/docker-compose.dev.yml up -d, rồi uv sync --extra postgres):
# MINICLOUD_DATABASE_URL=postgresql+psycopg://minicloud:minicloud@localhost:5432/minicloud

# Xếp instance: spread (dàn đều) hoặc binpack (dồn cho Green cloud)
MINICLOUD_PLACEMENT_POLICY=spread

# Green cloud: laptop chạy control plane không bao giờ ngủ; điền công suất đo được của laptop.
MINICLOUD_GREEN_PINNED_NODES=laptop-1
MINICLOUD_GREEN_IDLE_WATTS=8
MINICLOUD_GREEN_MAX_WATTS=35
